# Copia este archivo a .env y rellena los valores. ¡Nunca subas .env a GitHub!

# --- Telegram (obligatorio) ---
# Token del bot creado con @BotFather
TELEGRAM_BOT_TOKEN=
# Tu chat id: arranca el agente, escríbele al bot y te lo dirá
OWNER_CHAT_ID=
# Canal donde se publica (el bot debe ser administrador): @mi_canal o -100xxxxxxxxxx
TELEGRAM_CHANNEL=

# --- IA (obligatorio: una de las dos) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# openai | anthropic (si se deja vacío, usa anthropic cuando haya ANTHROPIC_API_KEY)
LLM_PROVIDER=
# Opcional: modelo concreto (por defecto gpt-4o-mini / claude-sonnet-5-5)
LLM_MODEL=

# --- VK (opcional) ---
# ID numérico de la comunidad (sin el signo menos)
VK_GROUP_ID=
# Token de USUARIO administrador con permisos wall,photos,video,groups,offline → publicar en el muro
VK_USER_TOKEN=
# Token de la COMUNIDAD con permiso de mensajes → respuestas automáticas
VK_GROUP_TOKEN=

# --- Otros ---
TIMEZONE=Europe/Moscow
DB_PATH=data/agent.db
BRAND_PATH=brand.json
